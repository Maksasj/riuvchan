# --- Build Output and Dependencies ---

# ESP-IDF build output directory
/build
/managed_components

# Configuration files generated by idf.py menuconfig
/sdkconfig

# Generated dependency lock file
/dependencies.lock

# Old or backup configuration files
/sdkconfig.old

# --- VS Code & Development Container Files ---

# VS Code specific settings (user-specific configurations)
/.vscode/

# Dev Container configuration files
/.devcontainer/

# --- Clangd & IDE/Tooling Files ---

# Clangd language server cache/config
/.clangd

# --- Source File Backups & Duplicates ---

# Example of an unnecessary file duplicate
i2c_oled_example_main copy.c

# --- Operating System Files ---

# macOS
.DS_Store

# Windows
Thumbs.db